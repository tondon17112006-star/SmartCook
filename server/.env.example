# Sao chép thành .env nếu cần thay đổi cấu hình mặc định.
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Windows Authentication: dùng tài khoản đang chạy tiến trình Node.js.
DB_AUTH=windows
DB_SERVER=lpc:localhost
# Shared memory không dùng DB_PORT. TCP có thể dùng DB_SERVER=localhost và DB_PORT=1433.
DB_PORT=
DB_NAME=SmartCookDB
DB_DRIVER=SQL Server Native Client 11.0
DB_ENCRYPT=true
# Chỉ đổi true khi development/test trên localhost cần tin chứng chỉ tự ký.
# Production bắt buộc false, Encrypt=true và ODBC Driver 17/18.
DB_TRUST_SERVER_CERTIFICATE=false
DB_CONNECTION_TIMEOUT=10000
DB_REQUEST_TIMEOUT=15000
DB_POOL_MAX=10

# Chạy npm run setup:auth để tạo hai khóa ngẫu nhiên riêng trong .env.
# JWT cố định 15 phút. Không đưa các khóa này vào client hoặc Git.
JWT_SECRET=
# Giữ nguyên khóa HMAC này trong suốt vòng đời mật khẩu; mất khóa cần đặt lại mật khẩu.
PASSWORD_PEPPER=
# HTTP localhost: false; production bắt buộc HTTPS và Secure=true.
AUTH_COOKIE_SECURE=false
